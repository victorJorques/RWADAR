# =====================================================================
#  RWAdar · claves del panel de control
# ---------------------------------------------------------------------
#  El panel copia este archivo como .env.local la primera vez que pulsas
#  «Abrir el archivo de claves». Rellena .env.local, NO este.
#  .env.local no se sube a Git. No compartas estas claves con nadie.
#  Después de guardar, cierra la ventana negra del panel y vuelve a abrirlo.
# =====================================================================

# Cloudflare: ver las visitas, los despliegues y apagar/encender la web.
# Permisos del token: «Account · Cloudflare Pages · Edit» y
#                     «Account · Account Analytics · Read».
CLOUDFLARE_API_TOKEN=

# Supabase: ver y gestionar las cuentas y retirar el catálogo.
# Supabase › Project Settings › API Keys › Secret keys (empieza por sb_secret_).
SUPABASE_SECRET_KEY=

# Supabase: contar cuántas veces se abre la app y la web (sus registros).
# Supabase › Account › Access Tokens (empieza por sbp_). Si deja elegir
# permisos, solo lectura de registros (analytics logs read).
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------
#  Solo para el panel compartido con los socios (npm.cmd run panel:nube)
# ---------------------------------------------------------------------

# Correos que pueden entrar, separados por comas (el tuyo también).
PANEL_SOCIOS=

# Los dos datos que enseña Cloudflare al pulsar «Enable Cloudflare Access»
# en Workers & Pages › rwadar-panel › Settings › Domains & Routes.
TEAM_DOMAIN=
POLICY_AUD=

# Opcional: para ver las tareas automáticas de GitHub desde la nube.
# Token «fine-grained» con permiso de solo lectura de Actions en RWADAR.
GITHUB_TOKEN=
