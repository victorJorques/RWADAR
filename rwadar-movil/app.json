{
  "expo": {
    "name": "RWAdar",
    "slug": "rwadar",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rwadar",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0A0A",
    "primaryColor": "#25E39A",
    "description": "Explora plataformas y activos tokenizados con fuentes, fechas y advertencias. Consulta editorial gratuita: RWAdar no recibe inversiones ni cobra comisiones por invertir.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rwadar.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rwadar.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "rwadar": {
        "pushDeliveryEnabled": false
      },
      "eas": {
        "projectId": "43de8651-0c57-40fc-8cdb-c9a8c72e6835"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#25E39A"
        }
      ],
      "expo-font",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/43de8651-0c57-40fc-8cdb-c9a8c72e6835"
    }
  }
}
